# Copy this file to .env and fill in real values. NEVER commit .env.
# Required
DATABASE_URL=
JWT_SECRET=

# First-run Admin bootstrap (optional; if empty, the setup form asks for them)
ADMIN_EMAIL=
ADMIN_PASSWORD=
COMPANY_NAME=

# AI (optional until the AI tasks; key stays on the server only)
AI_API_KEY=
AI_MODEL=
RATE_LIMIT_PER_HOUR=
